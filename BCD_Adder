//Design code 4 bit BCD Adder 
// Code your design here
module BCD_adder(A,B,Cin,Cout,S);
  input Cin;
  input [3:0]A,B;
  output reg Cout;
  output reg [3:0]S;
  reg [4:0]Z;
  always@(*)
    begin
      Z=A+B+Cin;
      if (Z>9)
        begin
          Z=Z+6;
          Cout=1;
          S=Z[3:0];
        end
      else begin
        Cout=0;
        S=Z[3:0];
      end
    end
endmodule

