// Design Code for Encoder
module encoder (I1,I2,I3,Y1,Y2);
  input I1,I2,I3 ;
  output Y1,Y2 ;
  wire W1, W2;
  not(W1,I2);
  and (W2,I1,W1);
  or (Y1,I1,W2);
  or ( Y2,I2,I3);
endmodule
