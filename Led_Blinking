// Design Code for Led Blinking
module led_blink( input clk, output reg led=0);
  reg[7:0] counter=0;
  always @(posedge clk) begin
    counter<=counter+1;
    if(counter<=8'd0)
      led<=~led;
  end
endmodule
// Test bench code
module led_blink_tb;
  reg clk=0;
  wire led;
  led_blink uut(.clk(clk), .led(led));
  always  #5 clk=~clk;
  initial begin 
    #50000;
    $finish;
  end
  initial begin
    $monitor("Time=%0t LED=%b", $time, led);
end

endmodule
