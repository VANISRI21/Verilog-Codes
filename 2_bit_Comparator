// Design code for Comparator 
// Code your design here
module comparator(A,B,AlB,AeB,AgB);
  input A,B ;
  output AlB,AeB,AgB ;
  wire W1,W2,W3,W4 ;
  not (W1,A);
  not (W2,B);
  and (W3,W1,W2);
  and (W4,A,B);
  and(AlB,W1,B);
  or (AeB,W3,W4);
  and (AgB,A,W2);
endmodule

