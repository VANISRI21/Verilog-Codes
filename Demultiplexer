// Design Code Demultiplexer
module demux(I,S,Y0,Y1);
  input I,S ;
  output Y0,Y1 ;
  wire W1 ;
  and (Y1,I,S);
  not (W2,S);
  and (Y0,W2,I);
endmodule
// Test bench code 
module demultiplexer ;
  reg I,S ;
  wire Y ;
  demux uut (.I(I), .S(S) ,.Y0(Y0), .Y1(Y1));
  integer i ;
